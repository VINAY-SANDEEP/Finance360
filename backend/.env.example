# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/finance360?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# OpenAI API (For AI Financial Assistant)
OPENAI_API_KEY=your_openai_api_key_here

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
